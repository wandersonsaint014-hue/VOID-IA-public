{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://void.invalid/schemas/toolcall.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "call_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "tool_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "inputs": { "type": "object" },
    "caller": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "permissions": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["call_id", "tool_id", "inputs", "caller"]
}
