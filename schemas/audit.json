{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://void.invalid/schemas/audit.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "entry_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "task_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "timestamp": { "type": "string", "format": "date-time" },
    "actor": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "action": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "outcome": { "type": "object" },
    "evidence": { "type": "array", "items": { "type": "object" } }
  },
  "required": ["entry_id", "task_id", "timestamp", "actor", "action"]
}
