{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://void.invalid/schemas/plan.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "plan_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "task_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "step.json" } },
    "created_by": { "type": "string" },
    "metadata": { "type": "object" }
  },
  "required": ["plan_id", "task_id", "steps"]
}
