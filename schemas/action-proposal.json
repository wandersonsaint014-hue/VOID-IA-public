{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://void.invalid/schemas/action-proposal.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "proposal_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "task_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "principal_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "tool_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "action": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "arguments_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "destination_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "capability_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["awaiting_review", "approved", "rejected", "expired", "cancelled"] }
  },
  "required": ["proposal_id", "task_id", "principal_id", "tool_id", "action", "arguments_digest", "capability_ids", "summary", "created_at", "expires_at", "status"]
}
