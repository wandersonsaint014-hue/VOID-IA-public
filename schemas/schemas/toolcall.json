{
  "$id": "io.void/tool",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tool_id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "schema_input": { "type": "object" },
    "schema_output": { "type": "object" },
    "permissions_required": { "type": "array", "items": { "type": "string" } },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
    "idempotent": { "type": "boolean" }
  },
  "required": ["tool_id", "schema_input", "schema_output"]
}
