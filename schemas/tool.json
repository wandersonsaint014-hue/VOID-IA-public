{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://void.invalid/schemas/tool.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tool_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "name": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "version": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "schema_input": { "type": "object" },
    "schema_output": { "type": "object" },
    "permissions_required": { "type": "array", "items": { "type": "string" } },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
    "idempotent": { "type": "boolean" }
  },
  "required": ["tool_id", "name", "version", "schema_input", "schema_output"]
}
